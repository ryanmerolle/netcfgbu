{
	"name": "netcfgbu Development",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.9-bullseye",
	"features": {
		"ghcr.io/devcontainers-contrib/features/invoke": {},
		"ghcr.io/devcontainers-contrib/features/ruff": {},
		"ghcr.io/devcontainers-contrib/features/pre-commit": {},
		"ghcr.io/va-h/devcontainers-features/uv:1": {}
	},
	"containerEnv": {
		"POETRY_VIRTUALENVS_IN_PROJECT": "true",
		"HISTFILE": "/home/vscode/.bash_history",
		"UV_LINK_MODE": "copy"
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "pip3 install --user -r requirements.txt",

	// Configure tool-specific properties.
	"customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "vscode"
}
